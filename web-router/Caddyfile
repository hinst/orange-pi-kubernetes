{
	order rate_limit before basicauth
}
:30001 {
	encode zstd gzip
	root * /usr/share/caddy
	rate_limit {
		zone dynamic_zone {
			key static
			events 100
			window 1s
		}
		except remote_ip 192.168.0.31
	}
	reverse_proxy /smartProgress-or* web-ui.smart-progress-or.svc:8080
	reverse_proxy /hinst-website* hinst-website.smart-progress-or.svc:8080
	reverse_proxy /web-counter* web-counter.smart-progress-or.svc:8080
	handle /adminer* {
		basic_auth {
			import adminerPassword.txt # This file should be in the same directory where Caddyfile is located
		}
		reverse_proxy /adminer* adminer.smart-progress-or.svc:8080
	}
	handle /configKeeper* {
		basic_auth {
			import configKeeperPassword.txt
		}
		reverse_proxy /configKeeper* config-keeper.config-keeper.svc:8080
	}
	handle /v2* {
		basic_auth {
			import dockerRegistryPassword.txt
		}
		reverse_proxy /v2* docker-registry-service.default.svc:5000
	}
	file_server
	log
}
